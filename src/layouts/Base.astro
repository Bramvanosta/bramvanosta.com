---
// Root layout for every site: SEO and social <head>, then the page.
import "../styles/global.css";
import { link } from "../lib/links.ts";
import { publicUrl, subsiteOfPath } from "../lib/sites.ts";

interface Props {
  title: string;
  description: string;
  /** The site's name in social cards: "Bram van Osta", "Ranch". */
  siteName: string;
  /** Social card, 1200 × 630, as a built path ("/og.png", "/ranch/og.png"). */
  image: string;
  imageAlt: string;
  /** For 404 pages: kept out of search results, with no canonical URL. */
  noindex?: boolean;
}

const { title, description, siteName, image, imageAlt, noindex = false } = Astro.props;
const path = Astro.url.pathname;
const canonical = publicUrl(path);
const subsite = subsiteOfPath(path);
const root = subsite ? `/${subsite}/` : "/";
---

<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    <meta name="color-scheme" content="light dark" />
    <link rel="icon" href={link(`${root}favicon.ico`, path)} sizes="32x32" />
    <link rel="icon" href={link(`${root}favicon.svg`, path)} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={link(`${root}apple-touch-icon.png`, path)} />
    <link rel="sitemap" href={link(`${root}sitemap.xml`, path)} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {!noindex && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={publicUrl(image)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={imageAlt} />
    <meta property="og:locale" content="en_GB" />
    <meta name="twitter:card" content="summary_large_image" />
    <slot name="head" />
  </head>
  <body>
    <slot />
  </body>
</html>
