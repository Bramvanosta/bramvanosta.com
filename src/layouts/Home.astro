---
// Layout of bramvanosta.com: one reading column, the page's <main> then the footer.
import { Font } from "astro:assets";
import { COPY } from "../lib/home-copy.ts";
import { DEFAULT_LOCALE, type Locale } from "../lib/i18n.ts";
import { PROFILE } from "../lib/profile.ts";
import Base from "./Base.astro";
import "../styles/home.css";

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
  locale?: Locale;
  alternates?: { hreflang: string; href: string }[];
  imageAlt?: string;
}

const {
  title,
  description,
  noindex = false,
  locale = DEFAULT_LOCALE,
  alternates = [],
  imageAlt = COPY[locale].imageAlt,
} = Astro.props;
---

<Base
  title={title}
  description={description}
  siteName={PROFILE.name}
  image="/og.png"
  imageAlt={imageAlt}
  noindex={noindex}
  locale={locale}
  alternates={alternates}
>
  <Font cssVariable="--font-inter" preload slot="head" />
  <Font cssVariable="--font-plex-mono" preload slot="head" />
  <Font cssVariable="--font-newsreader" preload slot="head" />
  <slot name="head" slot="head" />
  <div class="column">
    <slot />
    <footer>
      <span>
        © {new Date().getFullYear()} {PROFILE.name}
      </span>
      <span class="links">
        <a href={PROFILE.github}>GitHub</a>
        <a href={PROFILE.linkedin}>LinkedIn</a>
      </span>
    </footer>
  </div>
</Base>

<style>
  /* The design system's spacing: 72 px between sections, 32 px at the sides; 48 and 16 on a phone. */
  .column {
    max-width: 704px;
    margin: 0 auto;
    padding: 72px 32px;
    display: flex;
    flex-direction: column;
    gap: 72px;
  }

  footer {
    padding-top: 8px;
    border-top: 1px solid var(--line);
    display: flex;
    flex-wrap: wrap;
    gap: 0 24px;
    align-items: center;
    justify-content: space-between;
    font-size: 14px;
    line-height: 1.5;
    color: var(--ink-muted);
  }

  @media (max-width: 600px) {
    .column {
      padding: 48px 16px;
      gap: 48px;
    }
  }
</style>
