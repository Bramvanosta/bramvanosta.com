---
// Ranch's tile mark: a queue of bars, the orange one being worked on.
// Inline, so that the bars carry classes a parent can animate. The same drawing is
// public/ranch/favicon.svg, from which scripts/images/ renders the icons and social card.
interface Props {
  size: number;
  class?: string;
}

const { size, class: className } = Astro.props;
---

<svg class={className} width={size} height={size} viewBox="0 0 32 32" aria-hidden="true">
  <rect width="32" height="32" rx="7.2" fill="#17181c"></rect>
  <rect class="bar-active" x="13" y="8" width="12" height="4" rx="2" fill="#f28c38"></rect>
  <rect class="bar-waiting" x="7" y="14" width="12" height="4" rx="2" fill="#ececee"></rect>
  <rect class="bar-waiting" x="7" y="20" width="12" height="4" rx="2" fill="#ececee"></rect>
</svg>
