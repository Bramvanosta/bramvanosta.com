---
// One image from Retake's repository with its caption, as AVIF or WebP at the width its column needs.
import type { ImageMetadata } from "astro";
import { Picture } from "astro:assets";

interface Props {
  src: ImageMetadata;
  alt: string;
  caption: string;
  /** The column's width, for the browser to pick a file: a `sizes` attribute. */
  sizes: string;
}

const { src, alt, caption, sizes } = Astro.props;
---

<figure>
  <Picture
    src={src}
    alt={alt}
    formats={["avif", "webp"]}
    fallbackFormat="webp"
    widths={[400, 640, 828, 1056]}
    sizes={sizes}
    loading="lazy"
    decoding="async"
  />
  <figcaption>{caption}</figcaption>
</figure>

<style>
  figure {
    display: flex;
    flex-direction: column;
    gap: 12px;
    min-width: 0;
  }

  figure :global(img) {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 12px;
    border: 1px solid var(--line);
    box-shadow: 0 20px 50px -30px rgba(0, 0, 0, 0.35);
  }

  figcaption {
    font-size: 15px;
    color: var(--muted);
  }
</style>
