{
  "name": "bramvanosta.com",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "npm run build && wrangler dev --infer-origin-from-routes=false",
    "check": "astro check && prettier --check . && npm test",
    "test": "node --test 'worker/**/*.test.ts' 'src/**/*.test.ts'",
    "format": "prettier --write .",
    "images": "node scripts/images/render.mjs",
    "font": "node scripts/fonts/subset.mjs",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "astro": "^7.4.4"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/inter-tight": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/newsreader": "^5.3.0",
    "@types/node": "^24.19.2",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.2",
    "sharp": "^0.35.5",
    "subset-font": "^2.9.0",
    "typescript": "^6.0.3",
    "wrangler": "^4.155.0"
  }
}
